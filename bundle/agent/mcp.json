{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "pencil": {
      "type": "stdio",
      "command": "${PENCIL_MCP_COMMAND:-pencil-mcp}",
      "args": [
        "--app",
        "desktop"
      ],
      "enabled": false
    },
    "codebase-memory": {
      "type": "stdio",
      "command": "${CODEBASE_MEMORY_COMMAND:-codebase-memory-mcp}"
    },
    "rea": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.7.0",
        "mcp"
      ],
      "enabled": false
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
